<div class="wrapper d-flex flex-column justify-content-between">
  <div class="container">

    <div class="content-aligned py-3 container">
      <h1>GymBuddy</h1>
    </div>

    <div class="potential py-3">

    

      <div class="search-card">

        <h3>📍 Find Nearby Gym Buddies</h3>

        <%= form_with url: map_user_path(current_user),
                      method: :get,
                      local: true do %>

          <%= hidden_field_tag :latitude, "", id: "live_latitude" %>
          <%= hidden_field_tag :longitude, "", id: "live_longitude" %>

          <label class="radius-label">
            Search Radius
          </label>

          <input
            type="range"
            id="radiusSlider"
            name="radius"
            min="1"
            max="50"
            value="<%= params[:radius] || 10 %>"
            oninput="document.getElementById('radiusValue').innerHTML=this.value+' km'">

          <div id="radiusValue" class="radius-value">
            <%= params[:radius] || 10 %> km
          </div>

          <%= submit_tag "🔍 Search Nearby",
                class: "search-btn",
                id: "searchBtn" %>

        <% end %>

      </div>

    </div>

    <div
  id="map"
  class="map-container"
  style="width:100%; height:650px; margin-top:30px;"
  data-controller="map"
  data-map-markers-value='<%= @markers.to_json %>'
  data-map-api-key-value="<%= ENV["MAPTILER_API_KEY"] %>">
</div>

  </div>

  <%= render "shared/footer" %>

</div>